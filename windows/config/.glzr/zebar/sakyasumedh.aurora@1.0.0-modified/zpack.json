{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.1.1/resources/zpack-schema.json",
  "name": "aurora",
  "version": "1.0.0",
  "description": "Floating three-island top bar for GlazeWM: workspaces + window title, clock, interactive stats, media, volume and system tray.",
  "tags": [
    "topbar",
    "glazewm"
  ],
  "previewImages": [
    "./resources/preview-image-1.png"
  ],
  "repositoryUrl": "",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./bar.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "*.html",
        "*.css",
        "README.md"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "explorer",
            "argsRegex": "^(ms-[a-z-]+:[a-zA-Z0-9-]*|https://www\\.msn\\.com/[a-zA-Z0-9/_-]*)$"
          },
          {
            "program": "taskmgr",
            "argsRegex": "^$"
          },
          {
            "program": "SndVol",
            "argsRegex": "^$"
          },
          {
            "program": "powershell",
            "argsRegex": "^-NoProfile -WindowStyle Hidden -Command \\(New-Object -ComObject WScript\\.Shell\\)\\.SendKeys\\('\\^\\{ESC\\}'\\)$"
          },
          {
            "program": "explorer",
            "argsRegex": "^ms-settings-connectabledevices:devicediscovery$"
          },
          {
            "program": "powershell",
            "argsRegex": "^-NoProfile -NonInteractive -WindowStyle Hidden -EncodedCommand $"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "4px",
          "width": "100%",
          "height": "32px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
