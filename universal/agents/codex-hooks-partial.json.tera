{#- The source of the ~/.codex/hooks.json merge entry: codex-hooks-partial.json,
    combined with this machine's overlay when it has one (see
    mise/merge_local.py). exec() and read_file() run in ~/.config/mise. -#}
{% set overlay = xdg_config_home ~ "/dotfiles/local/.codex/hooks.json" -%}
{% if overlay is file -%}
{{ exec(command=(mise_bin | quote) ~ " x uv -- uv run --quiet --script ../merge_local.py ../../agents/codex-hooks-partial.json " ~ (overlay | quote)) }}
{%- else -%}
{{ read_file(path="../../agents/codex-hooks-partial.json") }}
{%- endif %}
