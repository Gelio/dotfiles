#!/usr/bin/env bash
# Keeps Karabiner's glazewm_running variable in step with GlazeWM: 1 while it
# runs, 0 while it's paused, and 0 once it exits or crashes. While the
# variable is 1, Karabiner turns Left Option+<key> into Option+Command+<key>,
# which apps would get as shortcuts (Option+Shift+Command+Q logs out at once)
# if GlazeWM weren't there to take them.
#
# GlazeWM starts this at startup. With --once, it syncs the variable and exits
# (used by glazewm-wake).
set -uo pipefail

PATH="/opt/homebrew/bin:$PATH"
karabiner_cli="/Library/Application Support/org.pqrs/Karabiner-Elements/bin/karabiner_cli"

# The value last written successfully, so a failed write is retried.
written=""

running() {
  pgrep -ix glazewm >/dev/null
}

# 1 only when GlazeWM runs and reports that it isn't paused. Anything else,
# including a failed query, gives 0.
wanted() {
  if running && glazewm query paused 2>/dev/null | grep -Eq '"data": *false'; then
    echo 1
  else
    echo 0
  fi
}

sync_once() {
  local value
  value=$(wanted)
  [[ "$value" == "$written" ]] && return 0
  "$karabiner_cli" --set-variables "{\"glazewm_running\":$value}" &&
    written=$value
}

# Retries for a few seconds, e.g. while Karabiner is still waking up.
sync_with_retries() {
  for _ in 1 2 3 4 5; do
    sync_once && return 0
    sleep 1
  done
  return 1
}

if [[ "${1:-}" == "--once" ]]; then
  sync_with_retries
  exit
fi

# Syncs on every pause change, and every 5 seconds as well: that covers a
# change before the subscription starts, a failed query and a failed write.
# The subscription ends if GlazeWM exits or its IPC connection drops, so
# resubscribe while GlazeWM still runs.
while running; do
  glazewm sub --events pause_changed 2>/dev/null | while true; do
    read -r -t 5 _
    status=$?
    sync_once
    # 0: an event, over 128: the timeout, anything else: the stream ended.
    ((status == 0 || status > 128)) || break
  done
  sleep 1
done
written=""
sync_with_retries
