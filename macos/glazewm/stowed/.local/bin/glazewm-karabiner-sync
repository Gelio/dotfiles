#!/usr/bin/env bash
# Keeps Karabiner's glazewm_running variable in step with GlazeWM: 1 while it
# runs, 0 while it's paused, isn't running or has crashed. While the variable
# is 1, Karabiner turns Left Option+<key> into Option+Command+<key>, which
# apps would get as shortcuts (Option+Shift+Command+Q logs out at once) if
# GlazeWM weren't there to take them.
#
# Runs all the time from a LaunchAgent (see macos/glazewm/install.sh). With
# --once, it syncs the variable and exits (used by glazewm-wake).
set -uo pipefail

PATH="/opt/homebrew/bin:$PATH"
karabiner_cli="/Library/Application Support/org.pqrs/Karabiner-Elements/bin/karabiner_cli"
# The app itself. `pgrep -x glazewm` would also match the CLI, including this
# script's own `glazewm sub`.
app=/Applications/GlazeWM.app/Contents/MacOS/glazewm

# The value last written successfully, so a failed write is retried.
written=""

app_running() {
  pgrep -f "^$app" >/dev/null
}

# 1 only when GlazeWM runs and reports that it isn't paused. Anything else,
# including a failed query, gives 0.
wanted() {
  if app_running && glazewm query paused 2>/dev/null | grep -Eq '"data": *false'; then
    echo 1
  else
    echo 0
  fi
}

sync_once() {
  local value
  value=$(wanted)
  [[ "$value" == "$written" ]] && return 0
  "$karabiner_cli" --set-variables "{\"glazewm_running\":$value}" &&
    written=$value
}

if [[ "${1:-}" == "--once" ]]; then
  # Retries for a few seconds, e.g. while Karabiner is still waking up.
  for _ in 1 2 3 4 5; do
    sync_once && exit 0
    sleep 1
  done
  exit 1
fi

# Don't leave `glazewm sub` behind when launchd stops this.
trap 'pkill -P $$' EXIT

while true; do
  if app_running; then
    sync_once
    # Syncs on every pause change, and every 5 seconds as well: that covers a
    # change before the subscription starts, a failed query and a failed
    # write. Process substitution rather than a pipe keeps `written` in this
    # shell. The subscription ends when GlazeWM exits.
    while true; do
      read -r -t 5 _
      status=$?
      sync_once
      # 0: an event, over 128: the timeout, anything else: the stream ended.
      ((status == 0 || status > 128)) || break
    done < <(glazewm sub --events pause_changed 2>/dev/null)
  fi
  sync_once
  sleep 2
done
