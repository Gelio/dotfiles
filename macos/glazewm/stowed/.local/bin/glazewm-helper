#!/usr/bin/env bash
# Background helper for GlazeWM on macOS, run all the time by one LaunchAgent
# (see macos/glazewm/install.sh):
#
# - Keeps Karabiner's glazewm_running variable in step with GlazeWM: 1 while
#   it runs, 0 while it doesn't (including after a crash). While it's 1,
#   Karabiner turns Left Option+<key> into Option+Command+<key>, which apps
#   would get as shortcuts (Option+Shift+Command+Q logs out at once) if
#   GlazeWM weren't there to take them.
# - On system or display wakeup, through sleepwatcher, runs `glazewm-helper
#   wake`: waking from system sleep clears the variable, and Zebar's bars
#   vanish after any display sleep.
# - Runs the same wake action when GlazeWM reports a monitor added or removed,
#   once monitors have settled: Zebar loses its bars then too, and a display
#   that drops out and reconnects isn't a display wakeup to sleepwatcher.
# - Rewrites the variable about once a minute, because Karabiner keeps it only
#   in memory: restarting Karabiner's core service (an update, say) unsets it.
#
# The LaunchAgent sends both output streams to
# ~/Library/Logs/com.github.gelio.glazewm-helper.log. The helper logs what it
# does with timestamps, and sleepwatcher logs each event it sees, after the
# command it ran for it.
set -uo pipefail

karabiner_cli="/Library/Application Support/org.pqrs/Karabiner-Elements/bin/karabiner_cli"
# The app itself: `pgrep -x glazewm` would also match the CLI.
app=/Applications/GlazeWM.app/Contents/MacOS/glazewm

# The value last written successfully, so a failed write is retried.
written=""
# Set while writes fail, so only the first failure and the recovery are logged.
failing=""
# The value last logged, so the minutely rewrite doesn't fill the log.
logged=""
# GlazeWM's monitor events write the time of the latest one here.
display_changed="${TMPDIR:-/tmp}/glazewm-helper-display-changed"

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') glazewm-helper[$$]: $*" >&2
}

app_running() {
  pgrep -f "^$app" >/dev/null
}

sync_once() {
  local value=0 out status
  app_running && value=1
  [[ "$value" == "$written" ]] && return 0
  # karabiner_cli fails while its socket is missing (asleep, or Karabiner
  # restarting) or still owned by root (just after login or a wake).
  if out=$("$karabiner_cli" --set-variables "{\"glazewm_running\":$value}" 2>&1); then
    written=$value
    if [[ -n "$failing" ]]; then
      log "Karabiner writes work again"
      failing=""
    fi
    [[ "$value" == "$logged" ]] || log "set glazewm_running to $value"
    logged=$value
  else
    status=$?
    [[ -n "$failing" ]] ||
      log "can't set glazewm_running to $value (exit $status): $out"
    failing=1
    return 1
  fi
}

# $1: what triggered it, for the log. Returns 75 when another wake is running.
wake() {
  log "wake ($1)"
  if ! app_running; then
    log "wake: GlazeWM isn't running, nothing to do"
    return 0
  fi

  # Both wakeup events can fire for one wake; run once.
  # Not local: the EXIT trap runs after this function returns.
  lock="${TMPDIR:-/tmp}/glazewm-helper-wake.lock"
  # A lock left by a killed run would block every later wake.
  find "$lock" -maxdepth 0 -mmin +1 -exec rmdir {} \; 2>/dev/null
  if ! mkdir "$lock" 2>/dev/null; then
    log "wake: another wake is running, skipping"
    return 75
  fi
  trap 'rmdir "$lock"' EXIT

  # Gives Karabiner time to finish waking up, then retries for a few seconds.
  sleep 3
  for _ in 1 2 3 4 5; do
    sync_once && break
    sleep 1
  done

  # Zebar ignores SIGTERM and SIGINT on macOS.
  pkill -KILL -ix zebar
  sleep 1
  # GlazeWM's shutdown command kills Zebar, so don't bring it back if GlazeWM
  # exited meanwhile.
  if app_running; then
    log "wake: restarting Zebar"
    open -a Zebar
  else
    log "wake: GlazeWM exited meanwhile, not restarting Zebar"
  fi
}

case "${1:-}" in
wake)
  wake "${2:-unknown}"
  exit
  ;;
log)
  shift
  log "$*"
  exit
  ;;
"") ;;
*)
  echo "usage: $0 [wake <reason> | log <message>]" >&2
  exit 2
  ;;
esac

log "started"

self="$(cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")"
sleepwatcher=/opt/homebrew/sbin/sleepwatcher
[[ -x "$sleepwatcher" ]] || sleepwatcher=/usr/local/sbin/sleepwatcher

# -w: system wakeup, -W: display wakeup. Waking from system sleep sends only
# the first. sleepwatcher runs each command with /bin/sh -c.
# -s, -S, -D and -U (system sleep, display sleep, dim and undim) only log, to
# show which events a display wake came as. sleepwatcher runs the -W command
# only when the display was off; when it was only dimmed, it runs -U instead.
# -V prints each event to stdout, and -s waits for its command before sleeping.
"$sleepwatcher" -V \
  -w "'$self' wake 'system wakeup'" \
  -W "'$self' wake 'display wakeup'" \
  -s "'$self' log 'system sleep'" \
  -S "'$self' log 'display sleep'" \
  -D "'$self' log 'display dim'" \
  -U "'$self' log 'display undim'" &
sleepwatcher_pid=$!

# Logs each monitor event from GlazeWM and records its time.
on_monitor_events() {
  local line event re='"eventType":"([a-z_]+)"'
  while IFS= read -r line; do
    event=unknown
    [[ "$line" =~ $re ]] && event=${BASH_REMATCH[1]}
    log "GlazeWM: $event"
    date +%s >"$display_changed"
  done
}

# Subscribes to GlazeWM's monitor events through its CLI, which exits when
# GlazeWM does. exec -a renames it so that app_running doesn't take it for
# GlazeWM itself. GlazeWM sends monitor_updated after every wake and on
# unrelated changes like unplugging a USB device, so this leaves it out.
start_monitor_watch() {
  exec -a glazewm-helper-sub "$app" sub -e monitor_added monitor_removed \
    > >(on_monitor_events) &
  monitor_watch_pid=$!
}

monitor_watch_pid=""
# Retries the subscription at most every 10 seconds: it fails until GlazeWM's
# IPC server is up, and each failure logs an error.
monitor_watch_retry=0
rm -f "$display_changed"
trap 'kill "$sleepwatcher_pid" $monitor_watch_pid 2>/dev/null' EXIT

refreshed=$SECONDS
# After a failed write, waits 10 seconds before the next try, so a Karabiner
# that's down for a while (during a dark wake, say) costs few calls.
retry_at=0
while true; do
  # Forgets the last write about once a minute, so this rewrites it.
  if ((SECONDS - refreshed >= 60)); then
    written=""
    refreshed=$SECONDS
  fi
  if ((SECONDS >= retry_at)); then
    sync_once || retry_at=$((SECONDS + 10))
  fi
  # Restarts sleepwatcher if it died, by exiting: launchd starts this again.
  if ! kill -0 "$sleepwatcher_pid" 2>/dev/null; then
    log "sleepwatcher exited, exiting so launchd restarts this"
    exit 1
  fi

  if app_running && ! kill -0 "$monitor_watch_pid" 2>/dev/null &&
    ((SECONDS >= monitor_watch_retry)); then
    start_monitor_watch
    monitor_watch_retry=$((SECONDS + 10))
  fi
  # Monitors can drop out and reconnect several times in a row, so this waits
  # until 5 seconds pass without a monitor event. While a sleepwatcher wake
  # runs, it waits for that to finish, then restarts Zebar again anyway: the
  # monitors may have changed after that wake restarted it.
  changed_at=""
  [[ -s "$display_changed" ]] && read -r changed_at <"$display_changed"
  if [[ -n "$changed_at" ]] && (($(date +%s) - changed_at >= 5)); then
    (wake "monitor added or removed")
    (($? == 75)) || rm -f "$display_changed"
  fi

  sleep 1
done
